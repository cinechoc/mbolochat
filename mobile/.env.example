# Copie ce fichier en `mobile/.env` si tu as besoin de forcer l'URL de l'API.
# Expo charge ./.env automatiquement (SDK 49+) ; redémarre `npx expo start` après modification.

# URL de l'API (optionnelle : l'app détecte l'hôte Expo par défaut).
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3001

# ——— TURN (relais WebRTC derrière les NAT mobiles) ———
# URLs séparées par des virgules (udp/tcp/tls). STUN optionnel, Google sinon.
# EXPO_PUBLIC_STUN_URLS=stun:stun.relay.metered.ca:80
# EXPO_PUBLIC_TURN_URLS=turn:global.relay.metered.ca:80,turns:global.relay.metered.ca:443?transport=tcp
# EXPO_PUBLIC_TURN_USERNAME=
# EXPO_PUBLIC_TURN_CREDENTIAL=
