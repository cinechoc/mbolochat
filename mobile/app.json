{
  "expo": {
    "name": "MboloChat",
    "slug": "mbolochat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mbolochat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "MboloChat utilise le micro pour les messages vocaux et les appels.",
        "NSCameraUsageDescription": "MboloChat utilise la caméra pour les appels vidéo et l’envoi de photos."
      },
      "UIBackgroundModes": [
        "audio"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1428",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.groupenzogho.mbolochat",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1428",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#3c87f7",
          "defaultChannel": "messages"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MboloChat utilise l’appareil photo pour prendre une photo à envoyer dans une discussion.",
          "microphonePermission": "MboloChat utilise le micro pour enregistrer des messages vocaux.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      "./plugins/withMessagingNotifications",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Cette app utilise le micro pour enregistrer vos messages vocaux."
        }
      ],
      "expo-asset",
      "expo-video",
      "expo-sharing",
      "react-native-blob-util",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MboloChat utilise votre position approximative pour afficher votre ville. Les coordonnées ne sont jamais enregistrées."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c2a657b3-6950-4b9c-803b-9958ad288616"
      }
    },
    "owner": "groupenzogho-dev"
  }
}
