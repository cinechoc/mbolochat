{
  "expo": {
    "name": "MboloChat",
    "slug": "mbolochat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mbolochat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3c87f7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.groupenzogho.mbolochat",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3c87f7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#3c87f7",
          "defaultChannel": "messages"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MboloChat utilise l’appareil photo pour prendre une photo à envoyer dans une discussion.",
          "microphonePermission": "MboloChat utilise le micro pour enregistrer des messages vocaux.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      "./plugins/withMessagingNotifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7c5665f6-9b3a-441a-9d05-e81b722cf004"
      }
    }
  }
}
