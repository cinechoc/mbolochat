DATABASE_URL=postgresql://mbolochat:mbolochat@localhost:5432/mbolochat
JWT_SECRET=change-me
PORT=3001

# Environnement d'exécution. En production, mets « production » : c'est ce qui
# empêche le code de réinitialisation du mot de passe d'être renvoyé au client ou
# écrit dans les journaux. Rien n'est renvoyé dès que cette valeur est autre que
# « development » ou « test ».
NODE_ENV=development

# Origines autorisées à appeler l'API depuis un navigateur, séparées par des
# virgules. Les applications mobiles n'envoient pas d'en-tête Origin et s'en
# passent ; le client web doit y figurer, sinon ses appels sont refusés.
CORS_ORIGINS=http://localhost:8081

# Clé des URLs de médias signées (images de discussions et avatars). À défaut,
# JWT_SECRET sert de clé — une valeur propre est préférable, pour pouvoir tourner
# l'une sans tourner l'autre.
# MEDIA_SECRET=

# Appels : serveurs ICE servis à l'application (GET /calls/ice-servers).
# STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
# TURN_URLS="turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443?transport=tcp"
# TURN_USERNAME=
# TURN_CREDENTIAL=
